# Copy to .env and fill in. Never commit the real file.
# Config also falls back to ../../00-environment/.env, so if the key already
# lives there you can leave this file out entirely.

# Key from https://build.nvidia.com/ (personal key or NGC key)
NVIDIA_API_KEY=nvapi-...

# Hosted NIM gateway. Swap for http://localhost:8000/v1 when you self-host in Week 8.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# A model the gateway serves AND your key is entitled to invoke — these are not
# the same set. Retired ids answer 410, un-entitled ids answer 404.
# Reasoning alternatives that also work: nvidia/nemotron-3-super-120b-a12b,
# nvidia/nemotron-3.5-lightning-30b-a3b
NIM_MODEL=meta/llama-3.2-11b-vision-instruct

# Browser origins allowed to hit this API (comma-separated)
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# 8081 so this can run alongside the FastAPI twin on 8080
PORT=8081
